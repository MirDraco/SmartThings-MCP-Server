# SmartThings Personal Access Token (PAT)
# Issue one at: https://account.smartthings.com/tokens
# Required scopes: r:devices:*, x:devices:*, r:locations:*, r:scenes:*, x:scenes:*
SMARTTHINGS_TOKEN=your-personal-access-token-here

# Transport mode: "stdio" (default, for local agent spawning) or "http" (for remote/networked access)
MCP_TRANSPORT=stdio

# HTTP transport settings (only used when MCP_TRANSPORT=http)
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=3000

# Optional bearer token to protect the HTTP endpoint.
# When set, clients must send: Authorization: Bearer <this value>
# Leave empty to disable auth (only safe on a trusted local network).
MCP_HTTP_AUTH_TOKEN=

# SmartThings API base URL (override only if needed)
SMARTTHINGS_API_BASE=https://api.smartthings.com/v1
