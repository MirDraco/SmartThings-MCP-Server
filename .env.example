# =============================================================================
# SmartThings MCP Server configuration
# =============================================================================
# This server drives SmartThings through the official `smartthings` CLI, which
# stores an OAuth access token + refresh token and auto-renews the access token.
# You do NOT put a token here. Instead you authenticate the CLI once (see README)
# and mount its credentials directory into the container.

# Host directory that contains the SmartThings CLI credentials/config.
# On Linux this is usually ~/.config/@smartthings
# docker-compose mounts this into the container. Change only if your CLI stores
# its config somewhere else.
SMARTTHINGS_CLI_DIR=~/.config/@smartthings

# Path to the smartthings CLI executable inside the container (leave default).
SMARTTHINGS_CLI_PATH=smartthings

# Transport mode: "stdio" (local agent spawning) or "http" (remote/networked).
# The container runs in http mode (set in docker-compose.yml).
MCP_TRANSPORT=http

# HTTP transport settings (only used when MCP_TRANSPORT=http)
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=3000

# Optional bearer token to protect the HTTP endpoint.
# When set, clients must send: Authorization: Bearer <this value>
# Leave empty to disable auth (only safe on a trusted local network).
MCP_HTTP_AUTH_TOKEN=
